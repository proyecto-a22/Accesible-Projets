<script>

let audioCtx = null;

function activarAudio(){
if(audioCtx) return;
audioCtx = new (window.AudioContext || window.webkitAudioContext)();
}

function sonido(freq,dur,vol){
if(!audioCtx) return;
let osc = audioCtx.createOscillator();
let gain = audioCtx.createGain();
osc.frequency.value = freq;
gain.gain.value = vol;
osc.connect(gain);
gain.connect(audioCtx.destination);
osc.start();
setTimeout(()=>osc.stop(),dur);
}

function clickUI(){
sonido(650,50,0.04);
}

["keydown","click","touchstart","pointerdown"].forEach(ev=>{
document.addEventListener(ev,activarAudio,{once:true});
});

document.querySelectorAll("#menuLista a").forEach(link=>{
link.addEventListener("mouseenter",clickUI);
link.addEventListener("focus",clickUI);
});

let btn = document.getElementById("menuBtn");
let lista = document.getElementById("menuLista");

btn.onclick = ()=>{

let abierto = btn.getAttribute("aria-expanded") === "true";

if(abierto){
lista.classList.remove("mostrar");
btn.textContent = "Menú contraído";
btn.setAttribute("aria-expanded","false");
}else{
lista.classList.add("mostrar");
btn.textContent = "Menú expandido";
btn.setAttribute("aria-expanded","true");
}

clickUI();

};

function actualizarReloj(){
let ahora = new Date();
let h = String(ahora.getHours()).padStart(2,"0");
let m = String(ahora.getMinutes()).padStart(2,"0");

document.getElementById("hora").textContent =
"Hora: " + h + ":" + m;

document.getElementById("fecha").textContent =
ahora.toLocaleDateString();
}

setInterval(actualizarReloj,1000);
actualizarReloj();

const leerVozAlta = document.getElementById("leerVozAlta");
const controlesLectura = document.getElementById("controlesLectura");
const velocidad = document.getElementById("velocidad");

let lecturaActual = null;

function detenerLectura(){
speechSynthesis.cancel();
lecturaActual = null;
}

function leerCapitulo(){

if(!leerVozAlta.checked) return;

detenerLectura();

lecturaActual = new SpeechSynthesisUtterance(
tituloCapitulo.textContent + ". " +
contenidoCapitulo.textContent
);

lecturaActual.lang = "es-ES";
lecturaActual.rate = parseFloat(velocidad.value);

speechSynthesis.speak(lecturaActual);

}

leerVozAlta.addEventListener("change",()=>{

controlesLectura.disabled = !leerVozAlta.checked;

if(leerVozAlta.checked){
leerCapitulo();
}else{
detenerLectura();
}

});

velocidad.addEventListener("input",()=>{

if(leerVozAlta.checked){
leerCapitulo();
}

});

window.addEventListener("beforeunload",detenerLectura);


let capitulos = [];
let indiceActual = 0;

const tituloCapitulo = document.getElementById("tituloCapitulo");
const contenidoCapitulo = document.getElementById("contenidoCapitulo");
const listaCapitulos = document.getElementById("listaCapitulos");

const btnAnterior = document.getElementById("btnAnterior");
const btnSiguiente = document.getElementById("btnSiguiente");

async function cargarLibro(){
try{
let res = await fetch("libros/El_Relicario.txt");
let texto = await res.text();

procesarTexto(texto);
renderLista();
mostrarCapitulo(0);

}catch(e){
console.log("Error cargando libro:", e);
tituloCapitulo.textContent = "Error al cargar el libro";
}
}

function procesarTexto(texto){
let partes = texto.split(/(?=Capítulo\s*\d+:)/g);

capitulos = partes.map(c=>{
let lineas = c.trim().split("\n");
let titulo = lineas[0];
let contenido = lineas.slice(1).join("\n").trim();

return {titulo, contenido};
}).filter(c=>c.titulo);
}

function renderLista(){
listaCapitulos.innerHTML = "";

capitulos.forEach((c,i)=>{
let li = document.createElement("li");
let b = document.createElement("button");

b.textContent = c.titulo;
b.onclick = ()=>mostrarCapitulo(i);

li.appendChild(b);
listaCapitulos.appendChild(li);
});
}

function mostrarCapitulo(i){
if(i < 0 || i >= capitulos.length) return;

indiceActual = i;

tituloCapitulo.textContent = capitulos[i].titulo;
contenidoCapitulo.textContent = capitulos[i].contenido;

document.getElementById("progreso").textContent =
`Capítulo ${i+1} de ${capitulos.length}`;

btnAnterior.disabled = i === 0;
btnSiguiente.disabled = i === capitulos.length - 1;

if(leerVozAlta.checked){
leerCapitulo();
}else{
detenerLectura();
}

}

btnAnterior.onclick = ()=>{
mostrarCapitulo(indiceActual - 1);
};

btnSiguiente.onclick = ()=>{
mostrarCapitulo(indiceActual + 1);
};

cargarLibro();

</script>

